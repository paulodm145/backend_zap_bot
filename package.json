{
  "name": "backend-zap-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Backend da plataforma de automação de WhatsApp ZapBot",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "tsx watch src/servidor.ts",
    "build": "npm run prisma:generate && tsc -p tsconfig.build.json",
    "start": "node dist/servidor.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "prisma:generate": "npm run prisma:central:generate && npm run prisma:tenant:generate",
    "prisma:central:generate": "prisma generate --config prisma.config.ts",
    "prisma:tenant:generate": "prisma generate --config prisma.tenant.config.ts",
    "db:central:migrate:dev": "prisma migrate dev --config prisma.config.ts",
    "db:central:migrate:deploy": "prisma migrate deploy --config prisma.config.ts",
    "db:central:seed": "prisma db seed --config prisma.config.ts",
    "db:tenant:migrate:dev": "prisma migrate dev --config prisma.tenant.config.ts",
    "db:tenant:migrate:deploy": "prisma migrate deploy --config prisma.tenant.config.ts",
    "db:tenant:migrate:todos": "tsx scripts/migrar-tenants.ts",
    "auth:limpar-refresh": "tsx scripts/limpar-refresh-tokens.ts",
    "admin:criar": "tsx scripts/criar-super-admin.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.81.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "otpauth": "^9.5.1",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prisma": "^7.9.1",
    "qrcode": "^1.5.4",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
