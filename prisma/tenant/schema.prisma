generator client {
  provider = "prisma-client"
  output   = "../../src/generated/prisma-tenant"
}

datasource db {
  provider = "postgresql"
}

enum PapelUsuarioTenant {
  ADMIN_TENANT
  GESTOR
  ATENDENTE

  @@map("papel_usuario_tenant")
}

model UsuarioTenant {
  id                        Int                  @id @default(autoincrement())
  public_id                 String               @unique @default(uuid()) @db.Uuid
  usuario_central_public_id String               @unique @db.Uuid
  nome                      String               @db.VarChar(150)
  nome_normalizado          String               @db.VarChar(150)
  email                     String               @unique @db.VarChar(254)
  papel                     PapelUsuarioTenant
  ativo                     Boolean              @default(true)
  deletado_at               DateTime?            @db.Timestamptz(3)
  created_at                DateTime              @default(now()) @db.Timestamptz(3)
  updated_at                DateTime              @updatedAt @db.Timestamptz(3)
  atendente                 Atendente?

  @@index([papel, ativo])
  @@index([ativo, nome_normalizado])
  @@index([deletado_at])
  @@map("usuarios_tenant")
}

model AuditoriaUsuarioTenant {
  id                     Int      @id @default(autoincrement())
  usuario_public_id      String   @db.Uuid
  autor_usuario_public_id String  @db.Uuid
  acao                   String   @db.VarChar(80)
  detalhes               Json?
  created_at             DateTime @default(now()) @db.Timestamptz(3)

  @@index([usuario_public_id, created_at])
  @@index([autor_usuario_public_id, created_at])
  @@map("auditorias_usuarios_tenant")
}

model Empresa {
  id                    Int      @id @default(autoincrement())
  public_id             String   @unique @default(uuid()) @db.Uuid
  chave                 String   @unique @default("PADRAO") @db.VarChar(20)
  razao_social          String?  @db.VarChar(180)
  nome_fantasia         String?  @db.VarChar(180)
  cnpj                  String?  @unique @db.VarChar(14)
  email                 String?  @db.VarChar(254)
  telefone              String?  @db.VarChar(16)
  site                  String?  @db.VarChar(255)
  cep                   String?  @db.VarChar(8)
  logradouro            String?  @db.VarChar(180)
  numero                String?  @db.VarChar(30)
  complemento           String?  @db.VarChar(120)
  bairro                String?  @db.VarChar(120)
  municipio_codigo_ibge String?  @db.VarChar(12)
  municipio_nome        String?  @db.VarChar(150)
  uf                    String?  @db.VarChar(2)
  created_at            DateTime @default(now()) @db.Timestamptz(3)
  updated_at            DateTime @updatedAt @db.Timestamptz(3)

  @@index([municipio_codigo_ibge])
  @@index([uf, municipio_nome])
  @@map("empresas")
}

enum StatusConversa {
  BOT
  AGUARDANDO_ATENDENTE
  COM_ATENDENTE
  ENCERRADA

  @@map("status_conversa")
}

enum DirecaoMensagem {
  ENTRADA
  SAIDA
  INTERNA
  @@map("direcao_mensagem")
}

enum AutorMensagem {
  CONTATO
  BOT
  ATENDENTE
  SISTEMA
  @@map("autor_mensagem")
}

enum StatusEntregaMensagem {
  RECEBIDA
  PENDENTE
  ENVIADA
  ENTREGUE
  LIDA
  FALHA
  @@map("status_entrega_mensagem")
}

enum TipoMensagem {
  TEXTO
  IMAGEM
  AUDIO
  DOCUMENTO
  SISTEMA

  @@map("tipo_mensagem")
}

enum StatusContaWhatsapp {
  PENDENTE
  VALIDADA
  INVALIDA

  @@map("status_conta_whatsapp")
}

model ContaWhatsapp {
  id                   Int                  @id @default(autoincrement())
  public_id            String               @unique @default(uuid()) @db.Uuid
  nome                 String               @db.VarChar(120)
  phone_number_id      String               @unique @db.VarChar(100)
  waba_id              String               @db.VarChar(100)
  numero_exibicao      String?              @db.VarChar(40)
  versao_graph_api     String               @default("v23.0") @db.VarChar(20)
  token_encrypted      String
  status               StatusContaWhatsapp @default(PENDENTE)
  ultima_validacao_at  DateTime?            @db.Timestamptz(3)
  ultimo_erro_codigo   String?              @db.VarChar(80)
  ultimo_erro_mensagem String?              @db.VarChar(500)
  ativo                Boolean              @default(true)
  deletado_at          DateTime?            @db.Timestamptz(3)
  created_at           DateTime             @default(now()) @db.Timestamptz(3)
  updated_at           DateTime             @updatedAt @db.Timestamptz(3)
  conversas            Conversa[]
  auditorias           AuditoriaWhatsapp[]

  @@index([ativo, deletado_at, nome])
  @@index([status, updated_at])
  @@map("contas_whatsapp")
}

model AuditoriaWhatsapp {
  id                Int              @id @default(autoincrement())
  conta_whatsapp_id Int?
  conta_public_id   String           @db.Uuid
  autor_usuario_id  String           @db.Uuid
  acao              String           @db.VarChar(80)
  detalhes          Json?
  created_at        DateTime         @default(now()) @db.Timestamptz(3)
  conta_whatsapp    ContaWhatsapp?   @relation(fields: [conta_whatsapp_id], references: [id], onDelete: SetNull)

  @@index([conta_public_id, created_at])
  @@index([autor_usuario_id, created_at])
  @@map("auditorias_whatsapp")
}

model Fluxo {
  id                                  Int           @id @default(autoincrement())
  public_id                           String        @unique @default(uuid()) @db.Uuid
  nome                                String        @db.VarChar(150)
  definicao                           Json
  versao                              Int           @default(0)
  ativo                               Boolean       @default(false)
  possui_alteracoes_nao_publicadas    Boolean       @default(true)
  publicado_at                        DateTime?      @db.Timestamptz(3)
  deletado_at                         DateTime?      @db.Timestamptz(3)
  created_at                          DateTime       @default(now()) @db.Timestamptz(3)
  updated_at                          DateTime       @updatedAt @db.Timestamptz(3)
  versoes                             FluxoVersao[]

  @@index([ativo, updated_at])
  @@index([deletado_at, updated_at])
  @@map("fluxos")
}

model FluxoVersao {
  id         Int      @id @default(autoincrement())
  public_id  String   @unique @default(uuid()) @db.Uuid
  fluxo_id   Int
  versao     Int
  definicao  Json
  created_at DateTime @default(now()) @db.Timestamptz(3)
  updated_at DateTime @updatedAt @db.Timestamptz(3)
  fluxo      Fluxo    @relation(fields: [fluxo_id], references: [id], onDelete: Cascade)

  @@unique([fluxo_id, versao])
  @@index([fluxo_id, created_at])
  @@map("fluxo_versoes")
}

model Contato {
  id         Int      @id @default(autoincrement())
  public_id  String   @unique @default(uuid()) @db.Uuid
  nome       String?  @db.VarChar(150)
  nome_normalizado String? @db.VarChar(150)
  telefone   String   @unique @db.VarChar(20)
  atributos  Json?
  created_at DateTime @default(now()) @db.Timestamptz(3)
  updated_at DateTime @updatedAt @db.Timestamptz(3)
  conversas  Conversa[]

  @@index([nome_normalizado])
  @@map("contatos")
}

model Setor {
  id          Int      @id @default(autoincrement())
  public_id   String   @unique @default(uuid()) @db.Uuid
  nome        String   @unique @db.VarChar(100)
  nome_normalizado String @db.VarChar(100)
  descricao   String?
  ativo       Boolean  @default(true)
  deletado_at DateTime? @db.Timestamptz(3)
  created_at  DateTime @default(now()) @db.Timestamptz(3)
  updated_at  DateTime @updatedAt @db.Timestamptz(3)
  atendentes  AtendenteSetor[]
  conversas   Conversa[]

  @@index([ativo, nome_normalizado])
  @@index([deletado_at])
  @@map("setores")
}

model Atendente {
  id                Int            @id @default(autoincrement())
  public_id         String         @unique @default(uuid()) @db.Uuid
  usuario_tenant_id Int?           @unique
  nome              String         @db.VarChar(150)
  email             String         @unique @db.VarChar(254)
  ativo             Boolean        @default(true)
  created_at        DateTime       @default(now()) @db.Timestamptz(3)
  updated_at        DateTime       @updatedAt @db.Timestamptz(3)
  usuario           UsuarioTenant? @relation(fields: [usuario_tenant_id], references: [id], onDelete: SetNull)
  setores           AtendenteSetor[]
  conversas         Conversa[]
  mensagens         Mensagem[]

  @@index([ativo, nome])
  @@map("atendentes")
}

model AtendenteSetor {
  id           Int        @id @default(autoincrement())
  atendente_id Int
  setor_id     Int
  created_at   DateTime   @default(now()) @db.Timestamptz(3)
  updated_at   DateTime   @updatedAt @db.Timestamptz(3)
  atendente    Atendente  @relation(fields: [atendente_id], references: [id], onDelete: Cascade)
  setor        Setor      @relation(fields: [setor_id], references: [id], onDelete: Restrict)

  @@unique([atendente_id, setor_id])
  @@index([setor_id, atendente_id])
  @@index([atendente_id, setor_id])
  @@map("atendentes_setores")
}

model Conversa {
  id                  Int            @id @default(autoincrement())
  public_id           String         @unique @default(uuid()) @db.Uuid
  conta_whatsapp_id   Int
  contato_id          Int
  setor_id            Int?
  atendente_id        Int?
  status              StatusConversa @default(BOT)
  estado_fluxo        Json?
  janela_expira_at    DateTime?       @db.Timestamptz(3)
  ultima_mensagem_at  DateTime?      @db.Timestamptz(3)
  finalizada_at       DateTime?      @db.Timestamptz(3)
  created_at          DateTime       @default(now()) @db.Timestamptz(3)
  updated_at          DateTime       @updatedAt @db.Timestamptz(3)
  conta_whatsapp      ContaWhatsapp  @relation(fields: [conta_whatsapp_id], references: [id], onDelete: Restrict)
  contato             Contato        @relation(fields: [contato_id], references: [id], onDelete: Restrict)
  setor               Setor?         @relation(fields: [setor_id], references: [id], onDelete: SetNull)
  atendente           Atendente?     @relation(fields: [atendente_id], references: [id], onDelete: SetNull)
  mensagens           Mensagem[]

  @@index([status, ultima_mensagem_at, id])
  @@index([contato_id, created_at])
  @@index([setor_id, status, ultima_mensagem_at])
  @@index([atendente_id, status, ultima_mensagem_at])
  @@index([conta_whatsapp_id, status, ultima_mensagem_at])
  @@map("conversas")
}

model Mensagem {
  id                 Int          @id @default(autoincrement())
  public_id          String       @unique @default(uuid()) @db.Uuid
  conversa_id        Int
  resposta_mensagem_id Int?
  autor_atendente_id Int?
  whatsapp_message_id String?     @unique @db.VarChar(150)
  tipo               TipoMensagem
  direcao            DirecaoMensagem
  autor              AutorMensagem
  status_entrega     StatusEntregaMensagem
  conteudo           Json
  recebida           Boolean
  midia_url          String?      @db.VarChar(1000)
  midia_mime_type    String?      @db.VarChar(150)
  midia_nome         String?      @db.VarChar(255)
  erro_codigo        String?      @db.VarChar(100)
  erro_mensagem      String?      @db.VarChar(500)
  ocorreu_at         DateTime     @db.Timestamptz(3)
  enviada_at         DateTime?    @db.Timestamptz(3)
  created_at         DateTime     @default(now()) @db.Timestamptz(3)
  updated_at         DateTime     @updatedAt @db.Timestamptz(3)
  conversa           Conversa     @relation(fields: [conversa_id], references: [id], onDelete: Cascade)
  resposta_mensagem  Mensagem?    @relation("RespostaMensagem", fields: [resposta_mensagem_id], references: [id], onDelete: SetNull)
  respostas          Mensagem[]   @relation("RespostaMensagem")
  autor_atendente    Atendente?   @relation(fields: [autor_atendente_id], references: [id], onDelete: SetNull)

  @@index([conversa_id, ocorreu_at, id])
  @@index([autor_atendente_id, ocorreu_at])
  @@index([status_entrega, updated_at])
  @@index([ocorreu_at, id])
  @@map("mensagens")
}

model CredencialIntegracao {
  id                    Int      @id @default(autoincrement())
  public_id             String   @unique @default(uuid()) @db.Uuid
  nome                  String   @db.VarChar(120)
  tipo_auth             String   @db.VarChar(30)
  configuracao_encrypted String
  ativo                 Boolean  @default(true)
  created_at            DateTime @default(now()) @db.Timestamptz(3)
  updated_at            DateTime @updatedAt @db.Timestamptz(3)

  @@index([ativo, nome])
  @@map("credenciais_integracao")
}

model RegistroUso {
  id         Int      @id @default(autoincrement())
  tipo       String   @db.VarChar(50)
  quantidade Int
  referencia String?  @db.VarChar(150)
  created_at DateTime @default(now()) @db.Timestamptz(3)
  updated_at DateTime @updatedAt @db.Timestamptz(3)

  @@index([tipo, created_at])
  @@index([created_at])
  @@map("registros_uso")
}
